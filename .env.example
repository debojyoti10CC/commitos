# Local demo works with no accounts or API keys. Use false for Supabase production.
DEMO_MODE=true
APP_URL=http://localhost:3000
APP_TIMEZONE=Asia/Kolkata
# Optional absolute writable directory; defaults to .data under the project.
DEMO_DATA_DIR=
# Optional in demo (a local key is generated). Required stable key for production.
SESSION_SECRET=

# Supabase project settings. Only these two NEXT_PUBLIC variables are public.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Required when DEMO_MODE=false.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only optional structured capture. Demo mode deliberately uses local parsing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local voice uses scripts/setup-voice.ps1 and .voice/ by default; no API key.
# Optional absolute runtime paths for another machine (server only).
VOICE_PYTHON=
VOICE_MODEL_DIR=

# Create a bot with BotFather; username excludes @.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Optional Google OAuth web client, Calendar and Gmail APIs enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# Server-only encryption key (32 random bytes encoded as base64).
ENCRYPTION_KEY=

# Random shared secret between the app and Cloudflare reminder worker.
CRON_SECRET=
